<title>ARMAN - Premium Store</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,Arial,sans-serif}
body{background:#0a0a0a;color:#fff}
header{display:flex;justify-content:space-between;align-items:center;padding:18px 5%;background:#000;position:sticky;top:0;z-index:10;border-bottom:1px solid #222}
.logo{font-size:24px;font-weight:900;letter-spacing:2px}
.logo span{color:#00ff88}
nav a{color:#fff;text-decoration:none;margin:0 14px;font-size:14px;opacity:.8}
nav a:hover{opacity:1;color:#00ff88}
.btn{background:#00ff88;color:#000;padding:10px 20px;border-radius:30px;font-weight:700;text-decoration:none}
.hero{padding:70px 5%;display:flex;gap:40px;align-items:center;flex-wrap:wrap}
.hero h1{font-size:52px;line-height:1.1}
.hero h1 span{color:#00ff88}
.hero p{margin:18px 0;color:#aaa;max-width:480px}
.hero-img{flex:1;min-width:280px;background:linear-gradient(135deg,#111,#1f1f1f);border-radius:20px;height:340px;display:flex;align-items:center;justify-content:center;font-size:80px}
.section{padding:50px 5%}
.section h2{font-size:28px;margin-bottom:20px}
.products{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.card{background:#151515;border:1px solid #222;border-radius:16px;padding:16px}
.card .img{height:170px;background:#222;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:50px}
.card h3{margin:12px 0 6px;font-size:17px}
.price{color:#00ff88;font-weight:800}
.old{color:#777;text-decoration:line-through;font-size:13px;margin-left:6px}
.card button{width:100%;margin-top:12px;padding:10px;border:0;border-radius:10px;background:#fff;font-weight:700;cursor:pointer}
.card button:hover{background:#00ff88}
.features{display:flex;gap:15px;flex-wrap:wrap}
.features div{flex:1;min-width:180px;background:#151515;padding:18px;border-radius:14px;border:1px solid #222}
footer{padding:30px 5%;text-align:center;color:#777;border-top:1px solid #222;font-size:13px}
@media(max-width:600px){.hero h1{font-size:36px} nav{display:none}}
</style>
</head>
